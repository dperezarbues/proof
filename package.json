{
  "name": "proof",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "bash scripts/setup-wasm.sh && lefthook install",
    "setup:wasm": "bash scripts/setup-wasm.sh",
    "dev": "bash scripts/setup-wasm.sh && next dev",
    "build": "bash scripts/setup-wasm.sh && next build",
    "start": "next start",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "check:templates": "node scripts/check-templates.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "pdfjs-dist": "6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "lefthook": "^2.1.9",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.7"
  }
}
